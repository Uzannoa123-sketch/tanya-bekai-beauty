# Copy these into Vercel: Project → Settings → Environment Variables. Never commit real values to Git.

# Site address (no trailing slash) – used to build the approval link for Tanya
SITE_URL=https://www.example.co.il

# Random secret of at least 32 characters (signs Tanya's approval links). Generate with: openssl rand -hex 32
BOOKING_LINK_SECRET=

# Secret for the daily reminder run (Vercel sends it to the cron automatically)
CRON_SECRET=

# --- Supabase (storing requests) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=he
# Tanya's number for request notifications (international format, digits only)
OWNER_WHATSAPP_NUMBER=972546824499
# Names of the templates approved in Meta (see docs/SETUP.md)
WA_TEMPLATE_OWNER_NEW_REQUEST=tb_new_request
WA_TEMPLATE_CLIENT_RECEIVED=tb_request_received
WA_TEMPLATE_CLIENT_CONFIRMED=tb_appointment_confirmed
WA_TEMPLATE_CLIENT_DECLINED=tb_request_declined
WA_TEMPLATE_CLIENT_REMINDER=tb_appointment_reminder

CLINIC_ADDRESS=שדרות האגמים 11, נתניה
APPOINTMENT_MINUTES=60

# --- Google Calendar (optional – real availability) ---
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Working hours for calculating free slots – fill in only after confirming with Tanya
WORK_HOURS=
SLOT_MINUTES=60
